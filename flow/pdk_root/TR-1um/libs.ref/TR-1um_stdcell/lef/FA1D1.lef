        RECT 0.000 0.000 89.600 2.600 ;
    END
  END GND
  PIN VDD
    DIRECTION INOUT ; USE POWER ;
    PORT
      LAYER M1 ;
        RECT 0.000 60.000 89.600 62.600 ;
    END
  END VDD
END FA1D1
