    END
  END Y
  OBS
    LAYER M1 ;
      RECT 13.100 6.400 15.700 9.800 ;
    LAYER M1 ;
      RECT 10.600 16.100 16.400 19.500 ;
    LAYER M1 ;
      RECT 18.200 16.100 19.000 19.500 ;
    LAYER M1 ;
      RECT 18.200 21.900 20.900 24.500 ;
    LAYER M1 ;
      RECT 18.200 27.100 19.000 30.500 ;
    LAYER M1 ;
      RECT 14.400 27.100 16.400 35.200 ;
    LAYER M1 ;
      RECT 7.400 6.400 16.400 51.200 ;
    LAYER M1 ;
      RECT 21.100 6.400 24.500 51.200 ;
    LAYER V1 ;
      RECT 16.600 17.100 18.000 18.500 ;
    LAYER V1 ;
      RECT 16.600 28.100 18.000 29.500 ;
    LAYER V1 ;
      RECT 22.100 33.600 23.500 35.000 ;
  END
END AND2_X1
