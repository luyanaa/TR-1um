# Python cache
__pycache__/
*.pyc
*.pyo
.DS_Store
libs.tech/klayout/klayoutrc
.slim/deepwork/
# Generated flow artifacts
LOG/

# ALIGN scratch/output trees. The checked-in ALIGN input deck remains visible.
flow/align_test/LOG/
flow/align_test/work_*/
flow/align_test/*.json
flow/align_test/*.sp
!flow/align_test/input/
!flow/align_test/input/**
flow/align_test/input/TELESCOPIC_OTA.placement_verilog.json

# LibreLane run databases, parameter sweeps, and derived PDK collateral.
flow/designs/*/runs/
flow/designs/*/config_*_sweep_*.yaml
flow/derived_native/


# Qualification reports are generated by default; retain the reusable manifest
# template and the exact final signoff bundle.
flow/qualification/*
!flow/qualification/ip62_beol_patch_manifest.template.json
!flow/qualification/post_layout_digital_manifest.json
!flow/qualification/analog_signoff_manifest.json
!flow/qualification/reports/
flow/qualification/reports/*
!flow/qualification/reports/gc-diode-repair13/
!flow/qualification/reports/gc-diode-repair13/**
!flow/qualification/reports/temperature-validation/
!flow/qualification/reports/temperature-validation/**
!flow/qualification/reports/pdn-emir/
!flow/qualification/reports/pdn-emir/**
!flow/qualification/reports/variation-analysis/
!flow/qualification/reports/variation-analysis/**

# Signoff reports and generated/intermediate artifacts.
flow/signoff/*/
flow/signoff/*.def
flow/signoff/*.extracted
flow/signoff/*.gds
flow/signoff/*.json
flow/signoff/*.log
flow/signoff/*.lvsdb
flow/signoff/*.lyrdb
flow/signoff/*.spef
flow/signoff/*.sp
flow/signoff/*.v
flow/signoff/*.cir
!flow/signoff/run_estimated_rcx.sh

# Characterization scratch decks. Reusable Python and model collateral stays
# visible, including fixed_models.sp and mos_fixed.lib.
flow/char/__pycache__/
flow/char/*_dc*.sp
flow/char/*_test*.sp
flow/char/*_fix*.sp
flow/char/inv_*.sp
flow/char/pmos_lib*.sp
flow/char/inv_dc*.sp
flow/char/inv_flat.sp
flow/char/inv_test*.sp

# The local LibreLane override is a generated/vendor tree. Keep only the
# project-specific override files versionable; ignore its generated bytecode.
flow/librelane_override/**/__pycache__/
!flow/librelane_override/
!flow/librelane_override/librelane/
!flow/librelane_override/librelane/flows/
!flow/librelane_override/librelane/flows/classic.py
!flow/librelane_override/librelane/scripts/
!flow/librelane_override/librelane/scripts/openroad/
!flow/librelane_override/librelane/scripts/openroad/rcx.tcl
!flow/librelane_override/librelane/scripts/odbpy/
!flow/librelane_override/librelane/scripts/odbpy/disconnected_pins.py
flow/signoff_test/

# Additional local verification/scratch outputs.
flow/tmp/
flow/verification/
flow/char/inv_*.sp
flow/char/nmos_*.sp
flow/char/pmos_*.sp
flow/char/*_dc*.sp
flow/char/*_test*.sp
flow/char/*_fix*.sp
