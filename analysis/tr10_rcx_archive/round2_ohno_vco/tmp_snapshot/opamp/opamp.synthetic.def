VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN TOP ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 10000000 10000000 ) ;

PINS 12 ;
- P1 + NET P1 + DIRECTION INOUT + FIXED ( 100000 100000 ) N ;
- P2 + NET P2 + DIRECTION INOUT + FIXED ( 120000 100000 ) N ;
- P3 + NET P3 + DIRECTION INOUT + FIXED ( 140000 100000 ) N ;
- P4 + NET P4 + DIRECTION INOUT + FIXED ( 160000 100000 ) N ;
- P5 + NET P5 + DIRECTION INOUT + FIXED ( 180000 100000 ) N ;
